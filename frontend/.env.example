# FireSight frontend environment
# Default is the H0 mock adapter. Switch to `http` when the H2 backend is running.
VITE_API_MODE=mock

# Used when VITE_API_MODE=http. The dev server proxies /api via VITE_PROXY_TARGET.
VITE_API_BASE_URL=/api

# Artificial latency for the mock adapter so loading states are visible.
VITE_MOCK_LATENCY_MS=160

# Local FastAPI/Uvicorn target for the Vite dev proxy.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Optional: set to 0 in automated runs for immediate mock responses.
